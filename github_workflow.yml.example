# To enable auto-building EXE on GitHub, manually create:
# .github/workflows/build-exe.yml  with this content via GitHub UI (github.com → Add file)
# GitHub Apps cannot push workflow files without 'workflows' permission — create it in the browser.
name: Build EXE
on:
  push:
    branches: [ main, arena/** ]
  workflow_dispatch:
jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: '3.11' }
      - run: pip install -r requirements.txt && pip install pyinstaller
      - run: pyinstaller --onefile --windowed --name UltimateProxyScrapper --icon=icon.ico main.py
      - uses: actions/upload-artifact@v4
        with: { name: UltimateProxyScrapper-windows, path: dist/UltimateProxyScrapper.exe }
  build-linux:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: '3.11' }
      - run: pip install -r requirements.txt && pip install pyinstaller && sudo apt-get update && sudo apt-get install -y libpython3.11-dev || true
      - run: pyinstaller --onefile --name UltimateProxyScrapper main.py
      - uses: actions/upload-artifact@v4
        with: { name: UltimateProxyScrapper-linux, path: dist/UltimateProxyScrapper }
